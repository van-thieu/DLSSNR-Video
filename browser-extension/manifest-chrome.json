{
  "manifest_version": 3,
  "name": "DLSS5 Video Controls",
  "version": "2.1.6",
  "description": "Tune DLSS5 neural rendering on streaming video and send the playing video to the DLSS5 player.",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "DLSS5 Video Controls"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Show DLSS5 controls"
    }
  }
}
